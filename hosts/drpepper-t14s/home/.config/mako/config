# layout
layer=top
anchor=top-right
margin=10
padding=8,12
max-visible=6
max-icon-size=48
font=General Sans 10
border-size=0

# colors
background-color=#1a1d1b
text-color=#d8d6cf

# behavior
default-timeout=6000

[urgency=critical]
default-timeout=0
border-size=2
border-color=#bf616a

[summary~="^(volume|brightness)$"]
anchor=bottom-center
outer-margin=0,0,72,0
width=240
height=30
padding=6,14
border-size=0
border-radius=15
default-timeout=1200
font=General Sans Bold 10
format=%b
text-alignment=center
background-color=#2a2e2b
text-color=#f0eee9

[summary="volume"]
progress-color=over #4f8a8b

[summary="brightness"]
progress-color=over #a8834a

[summary="volume" category="muted"]
progress-color=over #5a5d5b
text-color=#9a9894

[summary="system"]
default-timeout=3000
width=300

[summary="dnd"]
format=%b

[mode=do-not-disturb]
invisible=1

# keep the dnd toggle's own notice visible while the mode is on
[mode=do-not-disturb summary="dnd"]
invisible=0
