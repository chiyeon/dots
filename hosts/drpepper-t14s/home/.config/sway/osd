#!/bin/sh
# Volume/brightness bar for mako: osd volume|brightness <change>
# e.g. osd volume +5%, osd volume mute, osd brightness 5%-
case "$1" in
volume)
    case "$2" in
        mute) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
        *)    pactl set-sink-volume @DEFAULT_SINK@ "$2" ;;
    esac
    v=$(pamixer --get-volume)
    if pamixer --get-mute | grep -q true; then
        cat=muted icon=󰝟
    else
        cat=normal
        if [ "$v" -eq 0 ]; then icon=󰕿; elif [ "$v" -lt 50 ]; then icon=󰖀; else icon=󰕾; fi
    fi
    ;;
brightness)
    brightnessctl -q set "$2"
    v=$(brightnessctl -m | cut -d, -f4 | tr -d %)
    cat=normal icon=󰃠
    ;;
*) echo "usage: osd volume|brightness <change>" >&2; exit 1 ;;
esac
notify-send -c "$cat" -h "string:x-canonical-private-synchronous:$1" -h "int:value:$v" "$1" "$icon  $v%"
