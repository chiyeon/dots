[Desktop Entry]
Type=Application
Name=Vim (terminal)
Comment=Edit text files with vim in a terminal
Exec=sh -c "exec \\"\\$HOME/.scripts/vim-term\\" \\"\\$@\\"" vim-term %F
Terminal=false
Icon=gvim
Categories=Utility;TextEditor;
MimeType=text/plain;text/markdown;text/x-log;application/x-shellscript;application/json;application/x-yaml;application/toml;
NoDisplay=true
