" simple vimrc, optional plugins via VIM_ENABLE_PLUGINS=1

" --- GENERAL ---
let mapleader = " "   " set first: maps below expand <leader> when defined
set encoding=utf-8
set timeoutlen=300
set hidden
set noswapfile
set mouse=a
set clipboard=unnamed
if has('unnamedplus') | set clipboard=unnamedplus | endif
set shortmess+=I
set modelines=0

" --- VISUALS ---
set number
set ruler
set title
set background=dark
set laststatus=2
set showcmd
set wildmenu
set scrolloff=4
set sidescrolloff=8
set noerrorbells

" beam cursor in insert, block in normal
let &t_SI = "\<Esc>[6 q"
let &t_EI = "\<Esc>[2 q"

" --- SYNTAX & FILETYPES ---
syntax on
filetype plugin indent on

" --- INDENTATION ---
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set autoindent
set copyindent
set backspace=indent,eol,start

" --- WRAPPING ---
set wrap
set linebreak
set textwidth=0
set wrapmargin=0

" column guide at 80, toggle with <leader>c
set colorcolumn=80
highlight ColorColumn ctermbg=236 guibg=#303030
nnoremap <leader>c :let &l:colorcolumn = empty(&l:colorcolumn) ? '80' : ''<CR>

" --- SEARCH ---
set hlsearch
set incsearch
set ignorecase
set smartcase
set showmatch

" --- SPLITS ---
set splitbelow splitright

" --- KEYBINDINGS ---

" movement
nnoremap j gj
nnoremap k gk

" delete/change without yanking (leader prefix keeps normal d/c intact)
nnoremap <leader>d "_d
xnoremap <leader>d "_d
nnoremap <leader>D "_D
nnoremap x "_x
" paste over a selection without overwriting the register
xnoremap p P

" stay in visual mode after indent
vnoremap > >gv
vnoremap < <gv

" show all leader mappings
nnoremap <leader>? :map <leader><CR>

" clear search highlight
nnoremap <leader><space> :let @/=''<CR>

" formatting
nnoremap <leader>p gqip
nnoremap <leader>= gg=G

" buffers
nnoremap <leader>bl :buffers<CR>
nnoremap <leader>bn :bnext<CR>
nnoremap <leader>bp :bprev<CR>
nnoremap <leader>v <C-w>v
nnoremap <leader>s <C-w>s
nnoremap <leader>h <C-w>h
nnoremap <leader>j <C-w>j
nnoremap <leader>k <C-w>k
nnoremap <leader>l <C-w>l

" tabedit
nnoremap <leader>te :tabedit<CR>
nnoremap <leader>tc :tabclose<CR>
nnoremap <leader>tn :tabnext<CR>
nnoremap <leader>tp :tabprev<CR>

" toggle whitespace visualization
set listchars=tab:▸\ ,eol:¬
nnoremap <leader>w :set list!<CR>

" --- MARKDOWN ---
augroup markdown
  autocmd!
  autocmd FileType markdown setlocal tabstop=2 shiftwidth=2 softtabstop=2
  autocmd FileType markdown let &l:comments = 'b:- [x],b:- [ ],b:-,b:*'
  autocmd FileType markdown setlocal formatoptions+=ro
  " prose: spellcheck, no line numbers or column guide
  autocmd FileType markdown setlocal spell spelllang=en_us nonumber colorcolumn=
  " autosave when leaving insert mode, after normal-mode edits, or on focus loss
  autocmd FileType markdown autocmd! markdown TextChanged,InsertLeave,FocusLost,BufLeave <buffer> call s:Autosave()
augroup END

function! s:Autosave()
  if &modified && &buftype ==# '' && !empty(bufname()) && !&readonly
    silent! update
  endif
endfunction

" --- FOCUS MODE ---
" <leader>W centers the current buffer between blank side panes, hides UI
function! s:FocusOff()
  for b in get(t:, 'focus_pads', [])
    for w in win_findbuf(b) | call win_execute(w, 'close') | endfor
  endfor
  unlet! t:focus_pads
  let &laststatus = 2
  if exists('s:focus_split_hl') | call hlset(s:focus_split_hl) | unlet s:focus_split_hl | endif
  setlocal number< colorcolumn< fillchars<
  if &filetype ==# 'markdown' | setlocal nonumber colorcolumn= | endif
endfunction

function! s:FocusToggle()
  if exists('t:focus_pads') | return s:FocusOff() | endif
  silent! only
  let l:pad = max([0, (&columns - 84) / 2])
  let t:focus_pads = []
  for l:cmd in ['topleft vnew', 'botright vnew']
    execute l:cmd
    setlocal buftype=nofile bufhidden=wipe nobuflisted nonumber nospell colorcolumn=
    setlocal fillchars=vert:\ ,eob:\  statusline=\  winfixwidth
    execute 'vertical resize' l:pad
    call add(t:focus_pads, bufnr())
    wincmd p
  endfor
  set laststatus=0
  setlocal nonumber colorcolumn= fillchars=vert:\ ,eob:\ 
  " hide the split borders: blank separator chars with no reverse/background
  let s:focus_split_hl = hlget('VertSplit')
  highlight VertSplit cterm=NONE ctermfg=NONE ctermbg=NONE gui=NONE guifg=NONE guibg=NONE
endfunction

nnoremap <silent> <leader>W :call <SID>FocusToggle()<CR>
augroup focus_mode
  autocmd!
  " :q in focus mode closes the side panes too
  autocmd QuitPre * if exists('t:focus_pads') && index(t:focus_pads, bufnr()) < 0 | call s:FocusOff() | endif
augroup END

" --- NETRW ---
let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_winsize = 25
let g:netrw_browse_split = 0
let g:netrw_altv = 1
let g:netrw_fastbrowse = 1
let g:netrw_keepdir = 0

nnoremap <silent> <leader>e :Lexplore<CR>

" --- SPLASH SCREEN ---
function! s:Splash()
  if argc() || line('$') != 1 || getline(1) != '' | return | endif
  let l:art = [
    \ '⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢀⣀⠀⠀⠀⠀⠀⠀',
    \ '⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢀⠤⡶⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣏⠀⠙⢦⠀⠀⠀⠀',
    \ '⢰⠉⠑⢄⠀⢀⣀⡠⠤⠤⢄⣀⡎⠁⠀⢱⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠈⠱⣄⠀⠑⢄⠀⠀',
    \ '⠸⡀⠀⠈⠋⢁⣠⣀⠀⠀⠀⢈⣄⣀⣀⡘⡄⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠧⡀⠈⢦⠀',
    \ '⠀⢇⠀⢠⠞⣿⣷⣌⠇⠀⠀⡏⣿⣿⢀⡇⢇⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣠⠇⠀⠘⡄',
    \ '⠀⠸⡀⠸⠤⠽⢿⠏⠀⠀⠀⠉⠛⠛⠉⠀⠸⡀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢠⠼⠋⠁⠀⣀⡴⠃',
    \ '⠀⠀⢱⠀⠀⠀⠀⠀⠀⣰⠦⡀⠀⠀⠀⠀⠀⢇⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢸⠀⠀⢰⠋⠉⠀⠀',
    \ '⠀⠀⠈⢆⠀⠀⠀⠀⠀⠇⠀⠈⠢⠀⠀⠀⠀⠸⡀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠉⢦⠀⢸⡆⠀⠀⠀',
    \ ]
  let l:top = max([0, (winheight(0) - len(l:art)) / 2])
  let l:lpad = max([0, (winwidth(0) - strdisplaywidth(l:art[0])) / 2])
  let l:sp = repeat(' ', l:lpad)
  let l:lines = repeat([''], l:top) + map(copy(l:art), 'l:sp . v:val')
  call setline(1, l:lines)
  setlocal nomodified buftype=nofile nonumber noruler
  exe "setlocal fillchars+=eob:\\ "
  " defer the clear listener — CursorMoved fires during VimEnter startup
  " and would wipe the splash before the screen ever renders
  call timer_start(0, {_ -> s:SplashWatch()})
endfunction

function! s:SplashWatch()
  augroup splash_clear
    autocmd! CursorMoved,InsertEnter <buffer> call s:SplashClear()
  augroup END
endfunction

function! s:SplashClear()
  augroup splash_clear
    autocmd!
  augroup END
  silent! %delete _
  setlocal buftype= number ruler nomodified fillchars<
endfunction

augroup splash
  autocmd!
  autocmd VimEnter * call s:Splash()
augroup END

" --- PLUGINS ---
" vim-plug downloads itself and any missing plugins on first run
let s:vimdir = exists('$MYVIMDIR') ? substitute($MYVIMDIR, '/$', '', '') : expand('~/.vim')
let s:plug = s:vimdir . '/autoload/plug.vim'
if $VIM_ENABLE_PLUGINS == '1' && empty(glob(s:plug)) && executable('curl')
    silent execute '!curl -fsLo ' . shellescape(s:plug) . ' --create-dirs '
        \ . 'https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
endif

if $VIM_ENABLE_PLUGINS == '1' && filereadable(s:plug)
    execute 'source ' . fnameescape(s:plug)
    call plug#begin(s:vimdir . '/plugged')

    Plug 'vimwiki/vimwiki'
    Plug 'junegunn/goyo.vim'
    Plug 'junegunn/limelight.vim'
    Plug 'preservim/vim-pencil'

    call plug#end()

    " writing: Goyo replaces the built-in focus mode, Limelight dims other paragraphs
    let g:goyo_width = 80
    let g:limelight_conceal_ctermfg = 240
    let g:limelight_conceal_guifg = '#585858'
    nnoremap <silent> <leader>W :Goyo<CR>
    augroup goyo_limelight
      autocmd!
      autocmd User GoyoEnter nested Limelight
      autocmd User GoyoLeave nested Limelight!
    augroup END

    " pencil: prose-aware soft wrapping and motions for markdown
    let g:pencil#wrapModeDefault = 'soft'
    let g:pencil#conceallevel = 0
    " pencil clears this group before it ever creates it; define it up front
    augroup pencil_autoformat | augroup END
    augroup pencil_init
      autocmd!
      autocmd FileType markdown call pencil#init()
    augroup END

    augroup plug_auto
      autocmd!
      autocmd VimEnter * if !empty(filter(values(g:plugs), '!isdirectory(v:val.dir)'))
        \ | PlugInstall --sync | source $MYVIMRC | endif
    augroup END

    let g:vimwiki_list = [{
        \ 'path': (empty($NOTES_DIR) ? '~/.notes' : $NOTES_DIR) . '/',
        \ 'syntax': 'markdown',
        \ 'ext': '.md',
    \ }]

    " treat all .md files as VimWiki files
    let g:vimwiki_global_ext = 0
endif
