#!/bin/bash
# quick look style preview: opens a floating window; run again on the same file to close it, on another file to switch
# floating/sizing comes from ~/.config/sway/config.d/preview

file="$1"
state="${XDG_RUNTIME_DIR:-/tmp}/preview-file"

# toggle: close an open preview; stop if it was showing this same file,
# otherwise fall through and preview the new one
if swaymsg -q '[con_mark="^preview$"] kill' 2>/dev/null; then
    [ "$(cat "$state" 2>/dev/null)" = "$(realpath -- "$file" 2>/dev/null)" ] && exit 0
fi

[ -e "$file" ] || { echo "usage: preview <file>"; exit 1; }
realpath -- "$file" > "$state"

# terminal window for text-ish previews; space quits less
term() {
    foot --app-id=preview sh -c "$1" preview "$file" &
}
LESS_SPACE_QUIT='--lesskey-content=\ quit'

mime="$(file --brief --mime-type -- "$file")"

case "$mime" in
    video/*|audio/*)
        mpv --wayland-app-id=preview-video --force-window=yes --keep-open=yes \
            --autofit-larger=80%x85% \
            -- "$file" &>/dev/null &
        ;;
    image/*)
        imv -i preview -c 'bind <space> quit' -- "$file" &>/dev/null &
        ;;
    application/pdf)
        # zathura can't set its app id, so float it by pid once it maps
        zathura --config-dir="$HOME/.config/zathura-preview" -- "$file" &>/dev/null &
        pid=$!
        for _ in $(seq 50); do
            swaymsg -q "[pid=$pid] mark --add preview, floating enable, resize set 60 ppt 80 ppt, move position center" 2>/dev/null && break
            sleep 0.05
        done
        ;;
    text/*|application/json|application/x-shellscript|application/javascript|application/xml|application/toml|application/x-yaml|inode/x-empty)
        term "bat --paging=always --pager=\"less -R $LESS_SPACE_QUIT\" -- \"\$1\""
        ;;
    *)
        term "{ file -- \"\$1\"; echo; ls -lah --color=always -- \"\$1\"; } | less -R $LESS_SPACE_QUIT"
        ;;
esac
