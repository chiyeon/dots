#!/bin/bash
# notes            fuzzy find a note and edit it
# notes open PATH  create/edit a note
# notes view [PATH] render a note with glow (fuzzy find if no path)
# notes list       tree of all notes
dir="${NOTES_DIR:-$HOME/.notes}"
mkdir -p "$dir" && cd "$dir" || exit 1

pick() { find . -type f -not -path '*/.*' | sed 's|^\./||' | fzf; }

case "$1" in
    open) mkdir -p "$(dirname "$2")" && ${EDITOR:-vi} "$2" ;;
    view) f="${2:-$(pick)}"; [ -n "$f" ] && ${NOTES_VIEWER:-glow} "$f" ;;
    list) find . -not -path '*/.*' | sort ;;
    *)    f="$(pick)"; [ -n "$f" ] && ${EDITOR:-vi} "$f" ;;
esac
